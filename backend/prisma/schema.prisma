generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(uuid())
  name          String
  email         String           @unique
  phone         String?
  password      String
  role          Role             @default(USER)
  latitude      Float?
  longitude     Float?
  address       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  chatSessions  ChatSession[]
  ratingsGiven  Rating[]         @relation("RatingsGiven")
  requests      ServiceRequest[] @relation("UserRequests")
  workerProfile WorkerProfile?
  notifications Notification[]
  complaints    Complaint[]      @relation("ComplaintAuthor")
  categoryRequests ServiceCategory[] @relation("CategoryRequester")
  appRatings       AppRating[]
  passwordOtps     PasswordResetOtp[]
}

model WorkerProfile {
  id              String           @id @default(uuid())
  userId          String           @unique
  serviceType     ServiceType?
  serviceKey      String?
  applicationStatus ApplicationStatus @default(PENDING)
  applicationNote String?
  panNumber       String?          @unique
  profilePhotoKey String?
  panDocumentKey  String?
  faceFrontKey    String?
  faceLeftKey     String?
  faceRightKey    String?
  panVerified     Boolean          @default(false)
  faceVerified    Boolean          @default(false)
  kycReport       Json?
  idDocument      String?          @db.Text
  idDocumentName  String?
  idDocumentMime  String?
  isPublic        Boolean          @default(false)
  isAvailable     Boolean          @default(true)
  latitude        Float?
  longitude       Float?
  address         String?
  rating          Float            @default(0)
  totalJobs       Int              @default(0)
  bio             String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  ratingsReceived Rating[]         @relation("RatingsReceived")
  requests        ServiceRequest[] @relation("WorkerRequests")
  user            User             @relation(fields: [userId], references: [id])
  services        WorkerService[]
}

model ChatSession {
  id        String          @id @default(uuid())
  userId    String
  state     ChatState       @default(INIT)
  context   Json            @default("{}")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  messages  ChatMessage[]
  user      User            @relation(fields: [userId], references: [id])
  request   ServiceRequest?
}

model ChatMessage {
  id        String      @id @default(uuid())
  sessionId String
  role      String
  content   String
  metadata  Json?
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id])
}

model ServiceRequest {
  id            String         @id @default(uuid())
  sessionId     String?        @unique
  userId        String
  workerId      String?
  serviceType   ServiceType?
  serviceKey    String?
  description   String
  status        RequestStatus  @default(PENDING)
  userLatitude  Float?
  userLongitude Float?
  userAddress   String?
  proposedPrice Float?
  counterPrice  Float?
  finalPrice    Float?
  userApproved  Boolean        @default(false)
  workerNotes   String?
  @@index([bookingStage, expiresAt])
  bookingStage  String?
  expiresAt     DateTime?
  cancellationReason String?
  scheduledAt   DateTime?
  acceptedAt    DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  payment       Payment?
  rating        Rating?
  session       ChatSession?   @relation(fields: [sessionId], references: [id])
  user          User           @relation("UserRequests", fields: [userId], references: [id])
  worker        WorkerProfile? @relation("WorkerRequests", fields: [workerId], references: [id])
  complaints    Complaint[]
}

model ServiceCategory {
  id            String         @id @default(uuid())
  key           String         @unique
  name          String
  description   String?
  icon          String         @default("Wrench")
  keywords      String[]
  status        ApprovalStatus @default(PENDING)
  requestedById String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  requestedBy   User?          @relation("CategoryRequester", fields: [requestedById], references: [id])
  workers       WorkerService[]
}

model WorkerService {
  workerId   String
  categoryId String
  createdAt  DateTime        @default(now())
  worker     WorkerProfile   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  category   ServiceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([workerId, categoryId])
}

model Complaint {
  id          String          @id @default(uuid())
  authorId    String
  requestId   String?
  subject     String
  message     String
  status      ComplaintStatus @default(OPEN)
  adminNote   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  author      User            @relation("ComplaintAuthor", fields: [authorId], references: [id])
  request     ServiceRequest? @relation(fields: [requestId], references: [id])
}

model Notification {
  dedupeKey String? @unique
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AppRating {
  id        String   @id @default(uuid())
  userId    String
  score     Int
  comment   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model PasswordResetOtp {
  id        String   @id @default(uuid())
  userId    String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Payment {
  id                String         @id @default(uuid())
  requestId         String         @unique
  razorpayOrderId   String?        @unique
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Float
  currency          String         @default("INR")
  status            PaymentStatus  @default(PENDING)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  request           ServiceRequest @relation(fields: [requestId], references: [id])
}

model Rating {
  id        String         @id @default(uuid())
  requestId String         @unique
  raterId   String
  workerId  String
  score     Int
  comment   String?
  createdAt DateTime       @default(now())
  rater     User           @relation("RatingsGiven", fields: [raterId], references: [id])
  request   ServiceRequest @relation(fields: [requestId], references: [id])
  worker    WorkerProfile  @relation("RatingsReceived", fields: [workerId], references: [id])
}

enum Role {
  USER
  WORKER
  ADMIN
}

enum ServiceType {
  PLUMBER
  ELECTRICIAN
  AC_TECHNICIAN
  CARPENTER
}

enum RequestStatus {
  PENDING
  SEARCHING
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  PRICE_SET
  AWAITING_APPROVAL
  PAYMENT_PENDING
  PAID
  COMPLETED
  CANCELLED
  REJECTED
}

enum ChatState {
  INIT
  ISSUE_CAPTURED
  NEED_LOCATION
  CHOOSE_WORKER
  SEARCHING
  ASSIGNED
  AWAITING_PRICE
  PAYMENT_PENDING
  COMPLETED
}

enum PaymentStatus {
  PENDING
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

// Ownership and single-use claims for anonymous direct-to-S3 uploads.
model PendingUpload {
  key         String   @id
  ownerHash   String
  purpose     String
  contentType String
  expiresAt   DateTime
  claimId     String?
  usedAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([claimId])
  @@index([expiresAt])
}
